# Optional; defaults to the TFI Schedule zip
# SCHEDULE_URL=
# Where to publish the Schedule file: fs (default) or s3
# SCHEDULE_STORE=fs
# Folder for SCHEDULE_STORE=fs, relative to this folder
# SCHEDULE_DIR=.schedule/
# Required for SCHEDULE_STORE=s3; set from the bucket in .railway/railway.ts
# SCHEDULE_BUCKET_ENDPOINT=
# SCHEDULE_BUCKET_REGION=
# SCHEDULE_BUCKET_NAME=
# SCHEDULE_BUCKET_ACCESS_KEY_ID=
# SCHEDULE_BUCKET_SECRET_ACCESS_KEY=
