{
  "name": "@tfi-gtfs/tfi-gtfs-db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "typecheck": "tsc --noEmit true",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest"
  },
  "dependencies": {
    "@tfi-gtfs/tfi-gtfs-core": "workspace:*",
    "@tfi-gtfs/tfi-gtfs-utils": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@total-typescript/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
