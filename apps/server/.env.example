NODE_ENV=development
PORT=4000
# The folder `pnpm --filter @tfi-gtfs/schedule-sync dev` publishes to
SCHEDULE_DIR=../../jobs/schedule-sync/.schedule/
# Optional: SCHEDULE_STORE (fs by default; s3 needs the SCHEDULE_BUCKET_*
# variables)
SCHEDULE_POLL_INTERVAL_SECONDS=300
NTA_API_KEY=
# Optional: REALTIME_URL, REALTIME_REFRESH_INTERVAL_SECONDS (default 60)
# memory or redis, which needs REDIS_URL (`pnpm db:up`)
TRIP_UPDATE_STORE=memory
REDIS_URL=redis://localhost:6379
