NODE_ENV=development
PORT=4000
# Optional: comma-separated browser origins allowed by CORS
ORIGIN=http://localhost:8081
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tfi-gtfs
NTA_API_KEY=
# Optional: REALTIME_URL, REALTIME_REFRESH_INTERVAL_SECONDS (default 60)
# Optional: memory (default) or redis, which needs REDIS_URL (`pnpm db:up`)
TRIP_UPDATE_STORE=memory
REDIS_URL=redis://localhost:6379
